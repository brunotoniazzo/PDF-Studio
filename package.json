{
  "name": "pdf-studio",
  "version": "1.0.0",
  "private": true,
  "description": "PDF Studio — Editor e Leitor de PDF Local-First (Windows Desktop & Web PWA) com PDFium WASM, Cantoo pdf-lib e React",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@pdf-studio/web",
    "build:web": "npm run build --workspace=@pdf-studio/web",
    "preview:web": "npm run preview --workspace=@pdf-studio/web",
    "dev:desktop": "npm run dev --workspace=@pdf-studio/desktop-windows",
    "build:desktop": "npm run build --workspace=@pdf-studio/desktop-windows",
    "pack:windows": "npm run pack:win --workspace=@pdf-studio/desktop-windows",
    "dist:windows": "npm run dist:win --workspace=@pdf-studio/desktop-windows",
    "dist:windows:beta": "npm run dist:win:beta --workspace=@pdf-studio/desktop-windows",
    "typecheck": "tsc -b packages/platform-contracts packages/pdf-engine packages/editor-core packages/ui apps/web apps/desktop-windows",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
