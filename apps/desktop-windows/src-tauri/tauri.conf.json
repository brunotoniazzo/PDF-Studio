{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Studio",
  "version": "1.0.0",
  "identifier": "com.pdfstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 880,
        "minHeight": 560,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "description": "Documento PDF"
      }
    ]
  }
}
